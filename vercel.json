{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Bluebird",
      "destination": "/bluebird/",
      "permanent": true
    },
    {
      "source": "/Bluebird/:path*",
      "destination": "/bluebird/:path*",
      "permanent": true
    },
    {
      "source": "/BlueBird",
      "destination": "/bluebird/",
      "permanent": true
    },
    {
      "source": "/BlueBird/:path*",
      "destination": "/bluebird/:path*",
      "permanent": true
    },
    {
      "source": "/sunrise",
      "destination": "/Sunrise/",
      "permanent": true
    },
    {
      "source": "/sunrise/:path*",
      "destination": "/Sunrise/:path*",
      "permanent": true
    },
    {
      "source": "/Prime",
      "destination": "/prime/",
      "permanent": true
    },
    {
      "source": "/Prime/:path*",
      "destination": "/prime/:path*",
      "permanent": true
    },
    {
      "source": "/prime-designs",
      "destination": "/prime/",
      "permanent": true
    },
    {
      "source": "/prime-designs/:path*",
      "destination": "/prime/:path*",
      "permanent": true
    }
  ]
}
